# =============================================================================
# USN Candidate Screening Pipeline — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value's source is documented in SETUP_CHECKLIST.md.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=3000

# When true, the service LOGS what it would write to Airtable / send to a
# candidate instead of actually doing it. Use this for end-to-end testing
# without mutating Airtable or spamming candidates. Set to "false" for prod.
DRY_RUN=true

# --- Airtable (system of record) ---------------------------------------------
# Personal access token with data.records:read/write + schema.bases:read on the
# USN Operations base. https://airtable.com/create/tokens
AIRTABLE_TOKEN=
# Base ID of the USN Operations base (looks like "appXXXXXXXXXXXXXX").
AIRTABLE_BASE_ID=
# Table that holds candidate records (name or table id).
AIRTABLE_CANDIDATES_TABLE=Candidates
# Field (column) names — change ONLY if your Airtable columns are named
# differently. These must match your base exactly.
AIRTABLE_FIELD_EMAIL=Email
AIRTABLE_FIELD_NAME=Name
AIRTABLE_FIELD_STATUS=Status
AIRTABLE_FIELD_SCREEN_TYPE=Screen Type
AIRTABLE_FIELD_ANSWERS=Answers
AIRTABLE_FIELD_SCORE=Score
AIRTABLE_FIELD_SCORE_NOTES=Score Notes
AIRTABLE_FIELD_ONBOARDING_SENT_AT=Onboarding Sent At
AIRTABLE_FIELD_REMINDER_STAGE=Reminder Stage
AIRTABLE_FIELD_ONBOARDING_COMPLETED=Onboarding Completed

# --- VideoAsk (async video/audio screen) -------------------------------------
# Shared secret you set on the VideoAsk webhook. Sent as the
# `X-Webhook-Secret` header (or `?secret=` query param) and verified on inbound.
VIDEOASK_WEBHOOK_SECRET=
# Public URL of your VideoAsk screening form (the candidate-facing link).
VIDEOASK_URL=https://www.videoask.com/your-form-id

# --- Calendly (booked-call path) ---------------------------------------------
# Calendly webhook signing key (from the webhook subscription you create).
CALENDLY_WEBHOOK_SIGNING_KEY=
# Public scheduling URL for the screening event type.
CALENDLY_URL=https://calendly.com/your-org/screening-call

# --- Scoring / pass gate -----------------------------------------------------
# A screen scoring >= PASS scores a pass; >= REVIEW (but < PASS) needs human
# review; below REVIEW is a fail. Scores are 0–100.
SCORE_PASS_THRESHOLD=70
SCORE_REVIEW_THRESHOLD=50
# AI scorer provider for the video path. "none" => always route to manual
# review (default, no key needed). "example" => use the bundled example
# adapter (requires AI_SCORER_API_KEY).
AI_SCORER_PROVIDER=none
AI_SCORER_API_KEY=

# Shared secret protecting the interviewer call-outcome endpoint
# (POST /call-outcome). Sent as the `X-Interviewer-Secret` header.
INTERVIEWER_SECRET=

# --- Follow-up sequence ------------------------------------------------------
# Where passing candidates are sent to onboard. Placeholder for now.
ONBOARDING_URL=https://example.com/usn-onboarding
# Reminder cadence in days after the initial onboarding send.
REMINDER_DAY_2=2
REMINDER_DAY_4=4
# How often (minutes) the reminder scheduler scans for due nudges.
SCHEDULER_INTERVAL_MINUTES=180
# Set to "false" to disable the in-process scheduler (e.g. if you run the
# scan via an external cron hitting POST /tasks/run-reminders).
SCHEDULER_ENABLED=true

# --- Notifier (email/SMS provider — pluggable) -------------------------------
# "console" => log only (default). "example" => the bundled example adapter.
NOTIFIER_PROVIDER=console
NOTIFIER_API_KEY=
NOTIFIER_FROM_EMAIL=hiring@universalstaffingnetworks.com
NOTIFIER_FROM_SMS=+10000000000

# =============================================================================
# ONBOARDING STAGE (post-screening) — see SETUP_CHECKLIST.md › Onboarding
# =============================================================================

# Onboarding-stage Airtable field names (override only if your columns differ).
AIRTABLE_FIELD_ONBOARDING_STATUS=Onboarding Status
AIRTABLE_FIELD_DOCUSIGN_ENVELOPE_ID=DocuSign Envelope ID
AIRTABLE_FIELD_AGREEMENT_SIGNED_AT=Agreement Signed At
AIRTABLE_FIELD_GUSTO_SETUP_COMPLETE=Gusto Setup Complete
AIRTABLE_FIELD_AVAILABILITY=Availability
AIRTABLE_FIELD_ROLES=Roles
AIRTABLE_FIELD_TRANSPORT=Transport
AIRTABLE_FIELD_ATTIRE_SIZE=Attire Size
AIRTABLE_FIELD_HAS_BLACK_ATTIRE=Has Black Attire
AIRTABLE_FIELD_CERTS=Certs
AIRTABLE_FIELD_KLOQD_WORKER_ID=kloqd Worker ID

# Whether the scheduler also runs the onboarding scan (Steps 1, 3-advance, 5).
ONBOARDING_SCAN_ENABLED=true
# Lean deployment-data form, texted to the candidate after payment setup.
ONBOARDING_DATA_FORM_URL=https://example.com/usn-deployment-form

# --- DocuSign (Step 1 contractor agreement / Step 2 completion) --------------
# "console" => log only (default). "example" => the bundled DocuSign adapter.
DOCUSIGN_PROVIDER=console
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
# [CONFIRM] The DocuSign template id for the ICA (+ Schedule A).
DOCUSIGN_ICA_TEMPLATE_ID=
# Include the W-9 as a second document in the SAME envelope (one signing session).
DOCUSIGN_INCLUDE_W9=true
# HMAC key from DocuSign Connect, used to verify the completion webhook.
DOCUSIGN_CONNECT_HMAC_KEY=

# --- Gusto (Step 3 direct deposit) -------------------------------------------
# "manual" => a human fires the Gusto invite; pipeline advances when the
# "Gusto Setup Complete" checkbox is ticked. "api" reserved for future.
GUSTO_MODE=manual

# --- kloqd (Steps 5–6) — BLOCKED until you have the six facts -----------------
# Leave KLOQD_API_URL / KLOQD_AUTH_TOKEN blank to keep the push blocked: the
# pipeline will hold candidates at "USN Complete" and log the block, never guess.
KLOQD_API_URL=
KLOQD_AUTH_TOKEN=
KLOQD_AGENCY_JOIN_CODE=
KLOQD_COMPLETION_MODE=webhook
KLOQD_WEBHOOK_SECRET=
